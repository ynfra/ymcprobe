{
  "name": "ymcprobe",
  "version": "0.1.0",
  "description": "TUI for testing remote MCP servers through a headless opencode",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ymcprobe": "src/cli.tsx"
  },
  "scripts": {
