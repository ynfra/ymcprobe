    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "ink": "^6.3.1",
    "react": "^19.1.0",
    "react-devtools-core": "file:./stubs/react-devtools-core"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
